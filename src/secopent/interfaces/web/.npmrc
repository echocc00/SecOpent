# The Vite 8 template ships typescript@6.x; a few dev tools (openapi-typescript@7,
# and shadcn's transitive installs) still declare a `typescript@^5.x` peer range.
# TS 6 is backward-compatible for these codegen/UI tools, so we relax peer
# resolution project-wide rather than pin TypeScript down.
legacy-peer-deps=true
