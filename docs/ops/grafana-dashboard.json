{
  "title": "SecOpent Observability",
  "uid": "secopent-obs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus" },
        "query": "label_values(secopent_assessments_total, tenant)",
        "refresh": 2,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Assessments / s (by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(secopent_assessments_total{tenant=~\"$tenant\"}[5m])) by (status)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Findings / s (by severity)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(secopent_findings_total{tenant=~\"$tenant\"}[5m])) by (severity)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Oracle verification latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(secopent_oracle_verification_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Adapter run latency p95 (by adapter)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(secopent_adapter_run_seconds_bucket[5m])) by (le, adapter))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM tokens / s (by kind)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(secopent_llm_tokens_total{tenant=~\"$tenant\"}[5m])) by (kind)"
        }
      ]
    }
  ]
}
